# Public URL of the deployed site (used for SEO: canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.gangaaartievent.com

# Enquiry emails via Resend (https://resend.com) — create an API key and verify your domain
RESEND_API_KEY=
# Inbox that receives enquiries (defaults to the email in src/data/site.ts)
ENQUIRY_TO_EMAIL=
# Verified sender, e.g. "Ganga Aarti Website <enquiries@gangaaartievent.com>"
ENQUIRY_FROM_EMAIL=
